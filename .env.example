# Google AI Studio API Key (Required for Gemini models and embeddings)
# Obtain your key at https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# PostgreSQL Database Configuration
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Service URLs for internal container networking
ORCHESTRATOR_URL=http://orchestrator:8000
RETRIEVAL_AGENT_URL=http://retrieval-agent:8001
SYNTHESIS_AGENT_URL=http://synthesis-agent:8002

# Models Configuration (Google AI Studio)
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
GEMINI_MODEL=gemini-3.8-flash

# Retrieval Hyperparameters
DEFAULT_TOP_K=5
DEFAULT_DENSE_WEIGHT=0.6
DEFAULT_SPARSE_WEIGHT=0.4
RRF_K=60
